			(justify left bottom)
		)
		(uuid "0f30340c-d426-46e0-9b71-6134398cfa9a")
	)
	(text "Yellow in: 12V to 3.3V (inverting)"
		(exclude_from_sim no)
		(at 107.95 26.67 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "26ef0adc-1766-4f5f-8f8a-9c2f189223db")
	)
	(text "Notes:\ni: resistors r5,r8 and the 3.3v connection can be omitted but you will need to set:\n   input_mode_rx: INPUT_PULLUP\n   input_mode_mon: INPUT_PULLUP\nii: q1,q2,q3 and q4 can be substituted for other common small signal transistors. \niii: you can substitute resistor values but keep it within about 10% of the value up or down.  You may go down to 4.7k for all 10k resistors.\niv: Q2 2N3906 PNP, Q1/Q3/Q4 2N3904 NPN. TO-92 pin order E-B-C assumed, check datasheet.\nv: RX and MON are pulled up to the ESP32 3.3V by R5 and R8. \n   Yellow idles high (panel 10k pull-up, low ~0.7V). \n   Green idles low (panel 10k pull-down, 0V).\n"
		(exclude_from_sim no)
		(at 33.02 154.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "4bfafb47-8780-4ebc-b7b9-0cfbb39f1bb5")
	)
	(text "ECP (Honeywell/Ademco) interface - BJT version"
		(exclude_from_sim no)
		(at 50.8 17.78 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "65bf9600-4209-47e9-9afb-eba9a7ece792")
	)
	(text "Black = GND"
		(exclude_from_sim no)
		(at 30.48 52.07 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "7ea94eff-388a-4d40-b861-711bb0894452")
	)
	(text "Green monitor: 12V to 3.3V (inverting)"
		(exclude_from_sim no)
		(at 177.8 26.67 0)
		(effects
