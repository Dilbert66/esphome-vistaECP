				(size 1.27 1.27)
			)
			(justify right bottom)
		)
		(uuid "eb32e9fb-3775-4dac-b71a-17c038daa069")
	)
	(text "YAML config: \n  invert_mon: \"false\"\n  invert_rx: \"false\"\n  invert_tx: \"true\"\n  input_mode_rx: INPUT\n  input_mode_mon: INPUT\n\n  #ESP32C3 supermini pin config\n  rxpin: 7\n  txpin: 6\n  monitorpin: 5\n\nesp32: \n  variant: ESP32C3  \n  board: esp32-c3-devkitm-1\n\nNote: Since the internal logic already inverts the incoming data the above settings \nwill be the reverse to what the circuit does.\n\n"
		(exclude_from_sim no)
		(at 33.02 130.81 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "eb7052a2-6e31-4374-aabd-0de003accdb5")
	)
