	)
	(text "ESP32C3 supermini pins:\nrxpin: 7\ntxpin: 6\nmonitorpin: 5\n\nSeeed XIAO ESP32C3 pins:\nrxpin: 4\ntxpin: 3\nmonitorpin: 2\n\nESP32S3 supermini pins:\nrxpin: 43\ntxpin: 44\nmonitorpin: 1\n\nSeeed XIAO ESP32S3 pins:\nrxpin: 3\ntxpin: 2\nmonitorpin: 1\n\n"
		(exclude_from_sim no)
		(at 198.374 139.954 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "aa7ac835-653d-4a74-9c94-eb518faf49d4")
	)
	(text "Green out: 3.3V to 12V"
		(exclude_from_sim no)
		(at 155.448 100.584 0)
		(effects
